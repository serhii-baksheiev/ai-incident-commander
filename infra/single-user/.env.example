# The three host-side variables infra/single-user/compose.yaml interpolates.
# Copy this file to infra/single-user/.env (gitignored) and edit it; Compose
# reads .env automatically from the directory the compose file lives in.

# Path, on the HOST, to a file holding the postgres password. The file's
# CONTENT is the secret; this variable is only ever a path to it.
AIC_DB_PASSWORD_FILE=./secret-material/db-password

# Path, on the HOST, to the directory the cli service mounts read-only at
# /run/aic-secrets, for any CredentialRef material an Environment names.
AIC_SECRETS_HOST_DIR=./secret-material/credentials

# The loopback port the Incident Lab's api service publishes on, when a
# command runs with --profile lab. Compose interpolates this for EVERY
# command against this file, lab profile requested or not, so it must be set
# even for a plain `migrate` or `cli` run.
AIC_LAB_HOST_PORT=8080
