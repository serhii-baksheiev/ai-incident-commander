{
  "name": "ai-incident-commander",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/cli",
    "packages/domain",
    "packages/graph",
    "packages/roles",
    "packages/tools",
    "packages/persistence",
    "packages/evals",
    "packages/observability"
  ],
  "scripts": {
    "lint": "npm run lint:graph && npm run lint:domain && npm run lint:config",
    "lint:graph": "depcruise --config dependency-cruiser.config.mjs packages",
    "lint:domain": "eslint \"packages/domain/**/*.ts\" --max-warnings 0",
    "lint:config": "node scripts/check-domain-manifest.mjs && node scripts/check-domain-tsconfig.mjs",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "node --import ./test/fixtures/no-ambient-tracing.mjs --test",
    "test:live-lab": "node --import ./test/fixtures/no-ambient-tracing.mjs --test incident-lab/tests/*.live.mjs",
    "check": "npm run lint && npm run build && npm test",
    "cli": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
