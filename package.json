{
  "name": "ai-incident-commander",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/cli",
    "packages/domain",
    "packages/graph",
    "packages/roles",
    "packages/tools",
    "packages/persistence",
    "packages/evals",
    "packages/observability"
  ],
  "scripts": {
    "lint": "npm run lint:graph && npm run lint:domain && npm run lint:config",
    "lint:graph": "depcruise --config dependency-cruiser.config.mjs packages apps",
    "lint:domain": "eslint \"packages/domain/**/*.ts\" --max-warnings 0",
    "lint:config": "node scripts/check-domain-manifest.mjs && node scripts/check-domain-tsconfig.mjs",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "pretest": "npm run build",
    "test": "node --import ./test/fixtures/no-ambient-tracing.mjs --test",
    "test:live-lab": "npm run build --silent && node --import ./test/fixtures/no-ambient-tracing.mjs --test --test-concurrency=1 incident-lab/tests/*.live.mjs",
    "test:live-postgres": "npm run build --silent && node --import ./test/fixtures/no-ambient-tracing.mjs --test --test-concurrency=1 infra/postgres/tests/*.live.mjs",
    "live-lab:regenerate": "npm run build --silent && node --import ./test/fixtures/no-ambient-tracing.mjs incident-lab/bin/regenerate.mjs",
    "live-lab:validate-candidates": "npm run build --silent && node --import ./test/fixtures/no-ambient-tracing.mjs incident-lab/bin/validate-candidates.mjs",
    "eval:live-model": "npm run build --silent && node --import ./test/fixtures/no-ambient-tracing.mjs scripts/eval-live-model.mjs",
    "check": "npm run lint && npm run build && npm test",
    "cli": "node apps/cli/dist/index.js",
    "eval:final-holdout": "npm run build --silent && node --import ./test/fixtures/no-ambient-tracing.mjs scripts/eval-final-holdout.mjs",
    "eval:oracle": "npm run build --silent && node --import ./test/fixtures/no-ambient-tracing.mjs scripts/eval-oracle.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
