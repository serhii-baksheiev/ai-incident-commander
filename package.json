{
  "name": "ai-incident-commander",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/cli",
    "packages/domain",
    "packages/graph",
    "packages/roles",
    "packages/tools",
    "packages/persistence",
    "packages/evals",
    "packages/observability"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "node scripts/check-boundaries.mjs",
